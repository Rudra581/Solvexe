{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "WEBHOOK_SECRET",
    "JUDGE0_API_URL",
    "JUDGE0_CALLBACK_URL",
    "DATABASE_URL",
    "ACCELERATE_URL",
    "PORT",
    "HOST",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "JWT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
